      "stops": ["#f3e8ff", "#c9a6ff", "#8a3ffb", "#4a12b0"],
      "base": "#140430",
      "accent": "#ffffff",
      "animation": { "mode": "dazzle", "color": "#8a3ffb" },
      "live": "trip"
    },
    {
      "id": "fn-sky-drop",
      "name": "Sky Drop",
