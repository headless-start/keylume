{
  "collection": "Fortnite",
  "prefix": "fn",
  "section": "Games",
  "keys": [
    { "role": "movement", "keys": ["w", "a", "s", "d", "space", "lshift"] },
    { "role": "crouch", "keys": ["lctrl"] },
    { "role": "weapons", "keys": ["1", "2", "3", "4", "5"] },
    { "role": "combat", "keys": ["e", "r"] },
    { "role": "edit", "keys": ["g"] },
    { "role": "interface", "keys": ["tab", "m"] }
  ],
  "themes": [
    {
      "id": "fn-violet-tempest",
      "name": "Violet Tempest",
      "description": "Electric violet storm wall crackling with white lightning",
